# Supabase Configuration
# Obtén estas credenciales desde tu proyecto en https://supabase.com
# Settings → API

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_supabase_anon_key_aqui
SUPABASE_SERVICE_KEY=tu_supabase_service_role_key_aqui

# Nota: SUPABASE_SERVICE_KEY es opcional pero recomendado para operaciones de administrador
# Si no se proporciona, el sistema usará el método de registro público

# Para configurar:
# 1. Crea un proyecto en Supabase
# 2. Copia este archivo a .env
# 3. Reemplaza los valores con tus credenciales reales
# 4. La service_role key se encuentra en Settings → API → service_role key
